<Page x:Class="Front.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="clr-namespace:Front.Models"
      Title="Админ-панель"
      Background="{DynamicResource BackgroundBrush}">

    <Page.Resources>
        <Style x:Key="EmployeeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WorkBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRestDanger}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SummaryPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style x:Key="ToggleAdminButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="VerdictBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource RestBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Verdict}" Value="работа">
                    <Setter Property="Background" Value="{DynamicResource WorkBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VerdictTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                <Button x:Name="ThemeButton"
                        Style="{StaticResource IconButtonStyle}"
                        Click="ThemeButton_Click">☾</Button>
            </StackPanel>

            <Border Padding="18,20" Margin="0,0,0,14" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Поле админа"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Список сотрудников. В свернутом виде — процент работа/отдых. По кнопке развертки — детальная статистика по сайтам." />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Employees}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:EmployeeUsage}">
                        <Border Margin="0,0,0,14"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource EmployeeCardStyle}">
                            <StackPanel>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Margin="0,0,16,0">
                                        <TextBlock Text="{Binding FullName}"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Свернуто: процент работа/отдых"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="12" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Border Margin="0,0,10,0"
                                                Style="{StaticResource SummaryPillStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- removed decorative ellipses to avoid circle decorations -->
                                                <TextBlock Margin="0,0,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           Text="работа " />
                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding WorkPercent, Mode=OneWay}" />
                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           Text="%" />

                                                <TextBlock Margin="14,0,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           Text="отдых " />
                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding RestPercent, Mode=OneWay}" />
                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           Text="%" />
                                            </StackPanel>
                                        </Border>

                                        <Button Style="{StaticResource ToggleAdminButtonStyle}"
                                                Click="ToggleEmployee_Click"
                                                Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ToggleText, Mode=OneWay}" />
                                                <TextBlock Margin="8,0,0,0"
                                                           Text="{Binding ToggleGlyph, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource ChipBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1,1,1,0"
                                        Padding="16,14,16,16">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="Детальная статистика посещения сайтов"
                                                       Style="{StaticResource SectionTitleStyle}" />

                                            <Border Grid.Column="1"
                                                    Style="{StaticResource PillBorderStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Итого: " />
                                                    <TextBlock Text="{Binding TotalMinutes, Mode=OneWay}" />
                                                    <TextBlock Text=" мин" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Sites}">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:SiteUsage}">
                                                    <Border Margin="0,0,0,10"
                                                            Padding="12"
                                                            Style="{StaticResource CardBorderStyle}">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Name}"
                                                                           FontWeight="Bold"
                                                                           FontSize="14"
                                                                           Foreground="{DynamicResource TextBrush}" />

                                                                <TextBlock Grid.Column="1"
                                                                           Margin="12,0,10,0"
                                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                                           FontSize="12"
                                                                           Text="{Binding Minutes, StringFormat={}{0} мин}" />

                                                                <Border Grid.Column="2"
                                                                        Style="{StaticResource VerdictBorderStyle}">
                                                                    <TextBlock>
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource VerdictTextStyle}">
                                                                                <Setter Property="Text" Value="отдыхал" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Verdict}" Value="работа">
                                                                                        <Setter Property="Text" Value="работал" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </Grid>

                                                            <TextBlock Margin="0,0,0,10"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="12">
                                                                <Run Text="работа " />
                                                                <Run Text="{Binding WorkPercent, Mode=OneWay}" />
                                                                <Run Text="%" />
                                                                <Run Text="   •   " />
                                                                <Run Text="отдых " />
                                                                <Run Text="{Binding RestPercent, Mode=OneWay}" />
                                                                <Run Text="%" />
                                                            </TextBlock>

                                                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="14"
                                                                    Background="{DynamicResource CardBrush}">
                                                                <StackPanel>
                                                                    <Grid Margin="12,10,12,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="110" />
                                                                            <ColumnDefinition Width="120" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Text="Сайт / ссылка"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="Время"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="Статус"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                                    </Grid>

                                                                    <ItemsControl ItemsSource="{Binding Links}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                                                                        BorderThickness="0,1,0,0"
                                                                                        Padding="12,10">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="110" />
                                                                                            <ColumnDefinition Width="120" />
                                                                                        </Grid.ColumnDefinitions>

                                                                                        <Button Grid.Column="0"
                                                                                                Style="{StaticResource LinkButtonStyle}"
                                                                                                Click="OpenUrl_Click"
                                                                                                Tag="{Binding Url}"
                                                                                                Margin="0,0,12,0">
                                                                                            <StackPanel Orientation="Horizontal">
                                                                                                <TextBlock Text="{Binding Url}"
                                                                                                           TextTrimming="CharacterEllipsis"
                                                                                                           TextWrapping="NoWrap"
                                                                                                           TextDecorations="Underline" />
                                                                                                <Button Margin="8,0,0,0"
                                                                                                        Padding="6,4"
                                                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                                                        Visibility="{Binding Verdict, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=отдых}"
                                                                                                        Click="ScreenshotButton_Click">
                                                                                                    Скрин
                                                                                                </Button>
                                                                                            </StackPanel>
                                                                                        </Button>

                                                                                        <TextBlock Grid.Column="1"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                                                   FontSize="12"
                                                                                                   Text="{Binding Minutes, StringFormat={}{0} мин}" />

                                                                                        <Border Grid.Column="2"
                                                                                                HorizontalAlignment="Left"
                                                                                                Style="{StaticResource VerdictBorderStyle}">
                                                                                            <TextBlock>
                                                                                                <TextBlock.Style>
                                                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource VerdictTextStyle}">
                                                                                                        <Setter Property="Text" Value="отдыхал" />
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding Verdict}" Value="работа">
                                                                                                                <Setter Property="Text" Value="работал" />
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </TextBlock.Style>
                                                                                            </TextBlock>
                                                                                        </Border>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>