<Page x:Class="Front.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="clr-namespace:Front.Models"
      Title="Анализ дня"
      Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="14,12"
                        Margin="0,0,14,0"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="ФИО"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <Border Margin="0,6,0,0" Style="{StaticResource PillBorderStyle}">
                            <TextBlock Text="{Binding UserFullName}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ThemeButton"
                            Style="{StaticResource IconButtonStyle}"
                            Width="44"
                            Height="44"
                            Margin="0,0,0,0"
                            Click="ThemeButton_Click">☾</Button>
                </StackPanel>
            </Grid>

            <Border Padding="22" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="вы работаете уже" />
                        <Border Margin="0,8,0,0" Style="{StaticResource PillBorderStyle}" Padding="14,10">
                            <TextBlock x:Name="TimerTextBlock"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Text="00:00:00"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <Button x:Name="ToggleTimerButton"
                                Margin="0,12,0,0"
                                Width="120"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ToggleTimerButton_Click">Старт</Button>
                        <TextBlock x:Name="TimerStatusTextBlock"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Таймер остановлен" />
                    </StackPanel>

                    <TextBlock Margin="0,24,0,12"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="анализ дня:" />

                    <Border Padding="14" Background="{DynamicResource ChipBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding DashboardSites}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SiteUsage}">
                                        <StackPanel Width="120" Margin="0,0,12,0">
                                            <Border Height="170"
                                                    Padding="6"
                                                    Background="{DynamicResource CardBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14">
                                                <Grid VerticalAlignment="Bottom">
                                                    <Border Height="{Binding ChartHeight}"
                                                            VerticalAlignment="Bottom"
                                                            Background="{DynamicResource AccentSoftBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12,12,10,10" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Margin="0,8,0,0"
                                                       TextAlignment="Center"
                                                       Text="{Binding Name}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock TextAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding TimeDisplay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <ListBox x:Name="SitesListBox"
                             Margin="0,14,0,0"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding DashboardSites}"
                             SelectionChanged="SitesListBox_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,10,10" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root"
                                                    Padding="12,10"
                                                    CornerRadius="999"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    Background="{DynamicResource CardBrush}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SiteUsage}">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="DetailsBorder"
                            Margin="0,6,0,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DetailsTitleTextBlock"
                                           Style="{StaticResource SectionTitleStyle}"
                                           Text="Сайт" />
                                <Border Grid.Column="1" Style="{StaticResource PillBorderStyle}">
                                    <TextBlock x:Name="DetailsTotalTextBlock" Text="Итого: 00:00:00" />
                                </Border>
                            </Grid>

                            <DataGrid x:Name="LinksDataGrid"
                                      ItemsSource="{Binding SelectedSiteLinks}"
                                      Background="{DynamicResource CardBrush}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Посещённая ссылка" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="Hyperlink_RequestNavigate">
                                                        <Run Text="{Binding Url}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Время" Width="130" Binding="{Binding TimeDisplay}" />
                                    <DataGridTemplateColumn Header="Вердикт" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.Verdicts, RelativeSource={RelativeSource AncestorType=Page}}"
                                                          SelectedItem="{Binding Verdict, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Background="{DynamicResource CardBrush}"
                                                          Foreground="{DynamicResource VerdictTextBrush}"
                                                          BorderBrush="{DynamicResource BorderBrush}"
                                                          Padding="6,2"
                                                          HorizontalContentAlignment="Center">

                                                    <!-- Explicit ControlTemplate to ensure collapsed control background matches theme -->
                                                    <ComboBox.Template>
                                                        <ControlTemplate TargetType="ComboBox">
                                                            <Grid>
                                                                <Border x:Name="Bd"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="6"
                                                                        Padding="0">
                                                                    <Grid>
                                                                        <ContentPresenter x:Name="ContentSite"
                                                                                          Margin="6,0,26,0"
                                                                                          VerticalAlignment="Center"
                                                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                                                        <Path Data="M 0 0 L 8 0 L 4 5 Z"
                                                                              Fill="{TemplateBinding Foreground}"
                                                                              HorizontalAlignment="Right"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,0,8,0" />
                                                                    </Grid>
                                                                </Border>

                                                                <Popup x:Name="Popup"
                                                                       Placement="Bottom"
                                                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                                                       AllowsTransparency="True"
                                                                       Focusable="False"
                                                                       PopupAnimation="Fade">
                                                                    <Border Background="{DynamicResource CardBrush}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Padding="4">
                                                                        <ScrollViewer CanContentScroll="True"
                                                                                      MaxHeight="240"
                                                                                      Background="{DynamicResource CardBrush}">
                                                                            <ItemsPresenter />
                                                                        </ScrollViewer>
                                                                    </Border>
                                                                </Popup>

                                                                <!-- Invisible Toggle overlay to handle clicks and open/close -->
                                                                <ToggleButton x:Name="ToggleButton"
                                                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                              Background="Transparent"
                                                                              BorderBrush="Transparent"
                                                                              Focusable="False"
                                                                              HorizontalAlignment="Stretch"
                                                                              VerticalAlignment="Stretch"
                                                                              Cursor="Hand"
                                                                              Opacity="0" />
                                                            </Grid>

                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="HasItems" Value="false">
                                                                    <Setter TargetName="Popup" Property="Visibility" Value="Collapsed" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ComboBox.Template>

                                                    <!-- ensure items and popup content use theme brushes -->
                                                    <ComboBox.ItemContainerStyle>
                                                        <Style TargetType="ComboBoxItem">
                                                            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                            <Setter Property="Padding" Value="6,4" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsHighlighted" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.ItemContainerStyle>

                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Можно нажать на ссылку, чтобы перейти на страницу." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
