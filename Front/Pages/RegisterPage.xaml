<Page x:Class="Front.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация"
      Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Button x:Name="ThemeButton"
                Style="{StaticResource IconButtonStyle}"
                Width="44"
                Height="44"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,18,18,0"
                Click="ThemeButton_Click">☾</Button>

        <Border Width="420"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Регистрация"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Margin="0,6,0,18"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Введите логин и пароль, чтобы создать аккаунт." />

                <TextBlock Margin="0,4,0,6"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Логин" />
                <TextBox x:Name="LoginTextBox" MinWidth="200" />
				<TextBlock Margin="0,4,0,6"
										   Foreground="{DynamicResource MutedTextBrush}"
										   Text="ФИО" />
				<TextBox x:Name="FullNameTextBox" Margin="5"/>

                <TextBlock Margin="0,14,0,6"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Пароль(не менее 6 СИМВОЛОВ!)" />
                <PasswordBox x:Name="PasswordTextBox" />

                <Button Margin="0,18,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="RegisterButton_Click">Зарегистрироваться</Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
