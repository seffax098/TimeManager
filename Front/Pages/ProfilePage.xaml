<Page x:Class="Front.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль"
      Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,14">
                <Button x:Name="ThemeButton"
                        Style="{StaticResource IconButtonStyle}"
                        Width="44"
                        Height="44"
                        Margin="0,0,0,0"
                        Click="ThemeButton_Click">☾</Button>
            </StackPanel>

            <Border Padding="28" MaxWidth="720" HorizontalAlignment="Center" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Профиль"
                               FontSize="22"
                               FontWeight="Bold" />

                    <TextBlock Margin="0,10,0,18" Style="{StaticResource MutedTextStyle}">
                        <Run Text="ФИО:" />
                        <LineBreak />
                        <Run Text="{Binding UserFullName, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    </TextBlock>

                    <TextBlock Margin="0,0,0,6"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Рабочий стек" />
                    <TextBox x:Name="StackTextBox"
                             Text="{Binding WorkStackDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,10,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Укажи технологии и инструменты через запятую." />

                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click">Сохранить</Button>
                    </StackPanel>

                    <Border x:Name="ToastBorder"
                            Margin="0,12,0,0"
                            Padding="12,10"
                            Background="{DynamicResource ChipBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ToastTextBlock"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Сохранено." />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
