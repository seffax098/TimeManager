<Page x:Class="Front.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вход"
      Background="{DynamicResource BackgroundBrush}">
	<Grid>
		<Button x:Name="ThemeButton"
                Style="{StaticResource IconButtonStyle}"
                Width="44" Height="44"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,18,18,0"
                Click="ThemeButton_Click">☾</Button>

		<Border Width="420" Padding="28"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Style="{StaticResource CardBorderStyle}">
			<StackPanel>
				<TextBlock Text="Вход"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" />
				<TextBlock Margin="0,6,0,18"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Введите логин и пароль." />

				<TextBlock Margin="0,4,0,6"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Логин" />
				<TextBox x:Name="LoginTextBox" />

				<TextBlock Margin="0,14,0,6"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Пароль" />
				<PasswordBox x:Name="PasswordBox" />

				<Button Margin="0,18,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="LoginButton_Click">Войти</Button>
			</StackPanel>
		</Border>
	</Grid>
</Page>